[Unit]
Description=Vardrop server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vardrop
Group=vardrop
WorkingDirectory=/opt/vardrop
ExecStart=/opt/vardrop/vardrop-server serve --config /etc/vardrop/config.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vardrop
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
